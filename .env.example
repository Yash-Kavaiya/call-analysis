# =============================================================================
# Call Analysis — Production Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENVIRONMENT=development          # development | staging | production
APP_VERSION=0.4.0
DEBUG=false

# -----------------------------------------------------------------------------
# NVIDIA NIM (Required)
# -----------------------------------------------------------------------------
# Get a free API key at: https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_TIMEOUT=120.0
NVIDIA_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=call_analysis
DB_PASSWORD=changeme
DB_NAME=call_analysis
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_ECHO=false

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50

# -----------------------------------------------------------------------------
# Celery (Task Queue)
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_TIMEZONE=UTC
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3300
CELERY_WORKER_PREFETCH_MULTIPLIER=4
CELERY_WORKER_MAX_TASKS_PER_CHILD=100

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET_KEY=your-32-character-secret-key-here
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_API_KEY_PREFIX=ca_
AUTH_API_KEY_LENGTH=32
AUTH_BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT_LIMIT=100/minute
RATELIMIT_UPLOAD_LIMIT=10/minute
RATELIMIT_ANALYZE_LIMIT=20/minute
RATELIMIT_COPILOT_LIMIT=30/minute
RATELIMIT_STORAGE_URL=memory://

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
CORS_ENABLED=true
CORS_ALLOW_ORIGINS=["http://localhost:8787", "http://127.0.0.1:8787"]
CORS_ALLOW_CREDENTIALS=true

# -----------------------------------------------------------------------------
# ASR (Speech-to-Text)
# -----------------------------------------------------------------------------
ASR_MODEL_SIZE=base              # tiny | base | small | medium | large-v3
ASR_DEVICE=auto                  # auto | cpu | cuda
ASR_COMPUTE_TYPE=int8            # int8 | float16 | float32
ASR_BEAM_SIZE=5
ASR_VAD_FILTER=true
ASR_LANGUAGE=                    # auto-detect if empty

# -----------------------------------------------------------------------------
# Diarization
# -----------------------------------------------------------------------------
DIARIZATION_ENABLED=true
DIARIZATION_PROVIDER=heuristic   # heuristic | pyannote
DIARIZATION_HF_TOKEN=            # Required for pyannote
DIARIZATION_MIN_SPEAKERS=2
DIARIZATION_MAX_SPEAKERS=4

# -----------------------------------------------------------------------------
# PII Detection
# -----------------------------------------------------------------------------
PII_ENABLED=true
PII_CONFIDENCE_THRESHOLD=0.85

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=console               # json | console
LOG_FILE_PATH=                   # e.g., logs/app.log (empty = stdout only)
LOG_FILE_MAX_BYTES=10485760      # 10MB
LOG_FILE_BACKUP_COUNT=5

# -----------------------------------------------------------------------------
# OpenTelemetry
# -----------------------------------------------------------------------------
OTEL_ENABLED=true
OTEL_SERVICE_NAME=call-analysis
OTEL_SERVICE_VERSION=0.4.0
OTEL_ENVIRONMENT=development
OTEL_EXPORTER_ENDPOINT=http://localhost:4317
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_METRICS_INTERVAL=60

# -----------------------------------------------------------------------------
# File Storage
# -----------------------------------------------------------------------------
STORAGE_DATA_DIR=data
STORAGE_MAX_UPLOAD_SIZE=524288000  # 500MB
STORAGE_ALLOWED_EXTENSIONS=.m4a,.wav,.mp3,.ogg,.flac,.webm

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
SERVER_HOST=127.0.0.1
SERVER_PORT=8787
SERVER_WORKERS=1
SERVER_RELOAD=false
SERVER_ACCESS_LOG=true

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
FEATURE_WEBSOCKET_ENABLED=true
FEATURE_COPILOT_ENABLED=true
FEATURE_BATCH_IMPORT_ENABLED=true
FEATURE_REANALYZE_ENABLED=true
FEATURE_EXPORT_ENABLED=false
FEATURE_WEBHOOK_ENABLED=false
FEATURE_MULTI_TENANT=false
FEATURE_ADVANCED_DIARIZATION=false